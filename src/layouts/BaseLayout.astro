---
import '../styles/global.css';
import { SITE } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  /** When set, the page is rendered as an article: og:type=article,
   *  article:* meta tags, and BlogPosting structured data. */
  article?: {
    publishedTime: Date;
    modifiedTime?: Date;
    tags?: string[];
  };
  /** Marks this page as the canonical page *about* Brian (the About page).
   *  Adds ProfilePage + mainEntityOfPage so the Person entity has one home. */
  personPage?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage = '/og-default.png',
  canonicalUrl,
  noindex = false,
  article,
  personPage = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title} | ${SITE.seoTagline}`;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, SITE.url).toString();
const ogImageUrl = new URL(ogImage, SITE.url).toString();
const ogType = article ? 'article' : 'website';

// Structured data (schema.org), emitted as a single @graph so every page
// references ONE canonical Person node by @id rather than restating a fresh
// anonymous author object. That stable @id is the disambiguation signal: it
// tells a search engine that the Brian Baldock authoring these posts is the
// same entity as the one on the About page and on the linked profiles.
const PERSON_ID = `${SITE.url}/#brian`;
const WEBSITE_ID = `${SITE.url}/#website`;
const aboutUrl = `${SITE.url}/about/`;

const personNode = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: SITE.author,
  url: aboutUrl,
  image: new URL(SITE.person.image, SITE.url).toString(),
  jobTitle: SITE.person.jobTitle,
  worksFor: { '@type': 'Organization', name: SITE.person.worksFor },
  knowsAbout: SITE.person.knowsAbout,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.person.locality,
    addressRegion: SITE.person.region,
    addressCountry: SITE.person.country,
  },
  sameAs: Object.values(SITE.social),
};

const websiteNode = {
  '@type': 'WebSite',
  '@id': WEBSITE_ID,
  name: SITE.title,
  description: SITE.description,
  url: SITE.url,
  inLanguage: SITE.locale,
  author: { '@id': PERSON_ID },
  publisher: { '@id': PERSON_ID },
};

const pageNodes = article
  ? [
      {
        '@type': 'BlogPosting',
        '@id': `${canonical}#post`,
        headline: title,
        description,
        image: ogImageUrl,
        datePublished: article.publishedTime.toISOString(),
        dateModified: (article.modifiedTime ?? article.publishedTime).toISOString(),
        author: { '@id': PERSON_ID },
        publisher: { '@id': PERSON_ID },
        isPartOf: { '@id': WEBSITE_ID },
        mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
        url: canonical,
        ...(article.tags && article.tags.length ? { keywords: article.tags.join(', ') } : {}),
      },
    ]
  : personPage
    ? [
        {
          '@type': 'ProfilePage',
          '@id': canonical,
          url: canonical,
          name: fullTitle,
          description,
          isPartOf: { '@id': WEBSITE_ID },
          mainEntity: { '@id': PERSON_ID },
          about: { '@id': PERSON_ID },
        },
      ]
    : [];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [personNode, websiteNode, ...pageNodes],
};
// Escape '<' so a stray "</script>" in any field can't break out of the tag.
const jsonLdString = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={SITE.title} />
    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime.toISOString()} />
        {article.modifiedTime && (
          <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />
        )}
        <meta property="article:author" content={SITE.author} />
        {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script type="application/ld+json" is:inline set:html={jsonLdString} />

    <script is:inline>
      // Prevent dark-mode flash. Runs before paint.
      (function () {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.setAttribute('data-theme', t);
          }
        } catch (_) {}
      })();
    </script>

    <!-- GoatCounter: privacy-first, cookieless analytics. No consent banner needed. -->
    <script
      is:inline
      data-goatcounter="https://brianbaldock.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
