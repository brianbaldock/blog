---
// Legacy URL redirects.
//
// Hashnode served every post at the site root (e.g. /python-version-control).
// The Astro site serves them under /posts/<slug>/. Without these stubs, every
// old URL Google has indexed (and every external backlink) hits a hard 404 and
// the accumulated ranking authority is lost. Each generated page is a tiny
// meta-refresh redirect plus a canonical pointing at the new location, which
// Google treats as a 301-equivalent and consolidates authority through.
//
// The map is built from the posts collection so it can never drift out of sync
// with the actual content. It covers both the content id and any differing
// `slug` frontmatter value.
import { getCollection } from 'astro:content';
import { SITE } from '../consts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const seen = new Set<string>();
  const paths: { params: { slug: string }; props: { target: string } }[] = [];

  for (const post of posts) {
    const target = `/posts/${post.id}/`;
    const oldSlugs = new Set<string>([post.id]);
    if (post.data.slug) oldSlugs.add(post.data.slug);

    for (const slug of oldSlugs) {
      if (seen.has(slug)) continue;
      seen.add(slug);
      paths.push({
        params: { slug },
        props: {
          target,
          title: post.data.title,
          description: post.data.description ?? '',
          cover: post.data.cover ?? null,
        },
      });
    }
  }

  return paths;
}

const { target, title, description, cover } = Astro.props;
const canonical = new URL(target, SITE.url).toString();
// Mirror BaseLayout exactly: same title suffix, same description fallback, same
// og-image resolution. If the stub and the real post disagree about the title
// of the same content, the mirroring is worse than useless.
const fullTitle = `${title} | ${SITE.title}`;
const desc = description || SITE.description;
const ogImageUrl = new URL(cover ?? '/og-default.png', SITE.url).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      These stubs are what Bing actually ranks: 98.4% of post impressions
      (26,807 of 27,247) land here rather than on /posts/<slug>/, because the
      Hashnode-era URLs are what the world links to. GitHub Pages cannot serve
      a real 301, so a meta-refresh plus canonical is the only option.

      The failure this fixes: the stub previously carried <title>Redirecting…</title>
      and no description at all, so every one of those 26,807 impressions showed
      a search snippet Bing had to invent from nothing. Mirroring the target
      post's real title and description costs nothing, changes no URL, and gives
      the ranked page an honest snippet.

      Deliberately NOT noindex: these pages hold the inbound authority. Telling
      Bing to drop them would discard the ranking, not transfer it.
    */}
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p>
      This page has moved to <a href={target}>{title}</a>.
    </p>
  </body>
</html>
