---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Hand-curated for now. Easy to lift into a content collection later.
const projects = [
  {
    name: 'Hermes Agent',
    href: 'https://hermes-agent.nousresearch.com/',
    summary:
      'Long-running personal agent runtime with persistent memory, scheduled jobs, and gateway integrations across Discord, Signal, and more.',
    status: 'Active',
  },
  {
    name: 'AIgregator',
    href: 'https://aigregator.news/',
    summary:
      'Daily AI news digest, written by a scheduled agent and shipped as a static site each morning.',
    status: 'Active',
  },
  {
    name: 'Graph Engineering',
    href: 'https://agenticgraphs.dev/',
    summary:
      'A free 12-lesson course on knowledge-graph memory for AI agents. Starts by auditing the viral "90% of Anthropic engineers moved to agentic graphs" claim, then keeps the architecture that actually holds up: a temporal knowledge graph on SQLite, a validation gate that rejects ungrounded edges, cheap extraction versus expensive traversal, and an MCP server you wire into your own agent. Runs offline with no API key for the first three parts.',
    status: 'Active',
  },
  {
    name: 'Pack your SSID',
    href: '/posts/pack-your-ssid/',
    summary:
      'A pocket router that broadcasts a dedicated wifi network and tunnels every joined device back through infrastructure I actually control. GL.iNet OpenWrt, strongSwan IPsec to a FortiGate, and the diagnostic notes from the night the DHCP packets tried to take a vacation.',
    status: 'Stabilizing',
  },
];
---
<BaseLayout title="Projects" description="What I'm currently building or maintaining.">
  <section class="container">
    <h1>Projects</h1>
    <p class="muted">A short list of what I'm building or maintaining right now.</p>
    <ul class="project-list">
      {projects.map((p) => (
        <li>
          <div class="row">
            <h2><a href={p.href}>{p.name}</a></h2>
            <span class="tag">{p.status}</span>
          </div>
          <p>{p.summary}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .project-list { list-style: none; padding: 0; margin: 1.5rem 0; display: grid; gap: 1rem; }
  .project-list li {
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elev);
  }
  .row { display: flex; gap: 0.75rem; align-items: baseline; justify-content: space-between; }
  .row h2 { margin: 0; font-size: 1.15rem; }
</style>
